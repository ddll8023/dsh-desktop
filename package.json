{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.1.0",
  "description": "DeepSeek Harness desktop wrapper with dsh-codex and dsh-access-mode",
  "main": "src/main.js",
  "private": true,
  "author": "DSH Desktop",
  "license": "MIT",
  "scripts": {
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "start": "npm run prepare:runtime && electron .",
    "pack": "npm run prepare:runtime && electron-builder --dir",
    "pack:mac": "npm run prepare:runtime && electron-builder --mac dir",
    "pack:win": "npm run prepare:runtime && electron-builder --win dir",
    "dist": "npm run prepare:runtime && electron-builder",
    "dist:mac": "npm run prepare:runtime && electron-builder --mac",
    "dist:win": "npm run prepare:runtime && electron-builder --win",
    "dist:win:nsis": "npm run prepare:runtime && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "js-yaml": "^5.3.0"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DSH Desktop",
    "directories": {
      "output": "release"
    },
    "artifactName": "DSH-Desktop-${version}-${arch}-${os}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "ddll8023",
        "repo": "dsh-desktop",
        "releaseType": "release"
      }
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/node.tar.gz",
        "to": "node.tar.gz"
      },
      {
        "from": "resources/runtime.tar.gz",
        "to": "runtime.tar.gz"
      },
      {
        "from": "resources/runtime-manifest.json",
        "to": "runtime-manifest.json"
      },
      {
        "from": "resources/profile-web",
        "to": "profile-web"
      },
      {
        "from": "src/updater/update-helper.js",
        "to": "update-helper.js"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "title": "DSH Desktop ${version}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
